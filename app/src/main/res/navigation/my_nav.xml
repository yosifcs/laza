<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/my_nav"
    app:startDestination="@id/boardingFragment">
    <fragment
        android:id="@+id/boardingFragment"
        android:name="com.example.laza.ui.fragments.BoardingFragment"
        android:label="fragment_boarding"
        tools:layout="@layout/fragment_boarding">
        <action
            android:id="@+id/action_boardingFragment_to_loginOrRegisterFragment"
            app:destination="@id/loginOrRegisterFragment" />
    </fragment>
    <fragment
        android:id="@+id/loginOrRegisterFragment"
        android:name="com.example.laza.ui.fragments.LoginOrRegisterFragment"
        android:label="Let's Get Started"
        tools:layout="@layout/fragment_login_or_register">
        <action
            android:id="@+id/action_loginOrRegisterFragment_to_signUp"
            app:destination="@id/signUp" />
        <action
            android:id="@+id/action_loginOrRegisterFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>
    <fragment
        android:id="@+id/signUp"
        android:name="com.example.laza.ui.fragments.SignUpFragment"
        android:label="Sign Up"
        tools:layout="@layout/fragment_sign_up">
        <action
            android:id="@+id/action_signUp_to_homeFragment1"
            app:destination="@id/homeFragment" />
    </fragment>
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.laza.ui.fragments.LoginFragment"
        android:label="Welcome"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_forgotPasswordFragment"
            app:destination="@id/forgotPasswordFragment" />
        <action
            android:id="@+id/action_loginFragment_to_homeFragment1"
            app:destination="@id/homeFragment" />
    </fragment>
    <fragment
        android:id="@+id/forgotPasswordFragment"
        android:name="com.example.laza.ui.fragments.ForgotPasswordFragment"
        android:label="fragment_forgot_password"
        tools:layout="@layout/fragment_forgot_password">
        <action
            android:id="@+id/action_forgotPasswordFragment_to_verficationCodeFragment"
            app:destination="@id/verficationCodeFragment" />
    </fragment>
    <fragment
        android:id="@+id/verficationCodeFragment"
        android:name="com.example.laza.ui.fragments.VerficationCodeFragment"
        android:label="fragment_verfication_code"
        tools:layout="@layout/fragment_verfication_code">
        <action
            android:id="@+id/action_verficationCodeFragment_to_newPassword"
            app:destination="@id/newPassword" />
    </fragment>
    <fragment
        android:id="@+id/newPassword"
        android:name="com.example.laza.ui.fragments.NewPassword"
        android:label="fragment_new_password"
        tools:layout="@layout/fragment_new_password" />
    <fragment
        android:label=""
        android:id="@+id/homeFragment"
        android:name="com.example.laza.ui.fragments.HomeFragment"
        tools:layout="@layout/fragment_home" />
</navigation>