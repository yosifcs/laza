<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.chip.Chip
            android:id="@+id/sizeChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/detBTN"
            style="@style/Widget.Material3.Button.IconButton.Outlined"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            app:icon="@drawable/delete"
            app:iconGravity="textStart"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/decBTN"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginHorizontal="5dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="-"
            app:cornerRadius="800dp"
            app:layout_constraintBottom_toBottomOf="@+id/amountTV"
            app:layout_constraintStart_toEndOf="@+id/amountTV"
            app:layout_constraintTop_toTopOf="@+id/amountTV" />

        <TextView
            android:id="@+id/amountTV"
            style="@style/Text.Header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="5dp"
            android:text="TextView"
            app:layout_constraintBottom_toBottomOf="@+id/incBTN"
            app:layout_constraintStart_toEndOf="@+id/incBTN"
            app:layout_constraintTop_toTopOf="@+id/incBTN" />

        <TextView
            android:id="@+id/productNameTV"
            style="@style/Text.Header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="5dp"
            android:text="TextView"
            app:layout_constraintStart_toEndOf="@+id/productCoverIV"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/productPriceTV"
            style="@style/Text.Subline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="5dp"
            android:text="TextView"
            app:layout_constraintStart_toEndOf="@+id/productCoverIV"
            app:layout_constraintTop_toBottomOf="@+id/productNameTV" />

        <ImageView
            android:id="@+id/productCoverIV"
            android:layout_width="100dp"
            android:layout_height="100dp"

            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0"
            tools:srcCompat="@tools:sample/avatars" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/incBTN"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginHorizontal="5dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="+"
            app:cornerRadius="800dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/productCoverIV"
            app:layout_constraintTop_toBottomOf="@+id/productPriceTV" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>