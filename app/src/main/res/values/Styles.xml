<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- HeaderText Style -->
    <style name="Text.Header" parent="TextAppearance.AppCompat">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textAlignment">center</item>
    </style>

    <!-- SubText Style -->
    <style name="Text.Subline" parent="TextAppearance.AppCompat">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textAlignment">center</item>
    </style>

    <!-- Card Style -->
    <style name="Widget.Laza.Card" parent="Widget.Material3.CardView.Elevated">
        <!-- Background -->
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <!-- Shape -->
        <item name="cornerSize">20dp</item>
        <item name="cardUseCompatPadding">true</item>
        <!-- Elevation -->
        <item name="cardElevation">0dp</item>
        <item name="android:layout_marginBottom">50dp</item>
    </style>

    <!-- App bar Style -->
    <style name="Widget.Laza.ActionBar" parent="Widget.AppCompat.ActionBar">
        <item name="background">@android:color/transparent</item>
        <item name="elevation">0dp</item> <!-- Removes the shadow -->

    </style>

    <!-- Facebook Button Style -->
    <style name="Widget.Laza.FacebookButton" parent="Widget.Material3.Button">
        <item name="colorPrimary">@color/facebook_blue</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/facebook_blue</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">0dp</item>
    </style>

    <!-- Twitter Button Style -->
    <style name="Widget.Laza.TwitterButton" parent="Widget.Material3.Button">
        <item name="colorPrimary">@color/Twitter_blue</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/Twitter_blue</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_marginHorizontal">10dp</item>
    </style>

    <!-- Google Button Style -->
    <style name="Widget.Laza.GoogleButton" parent="Widget.Material3.Button">
        <item name="colorPrimary">@color/google_red</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/google_red</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">0dp</item>
    </style>

    <style name="Widget.Theme.Laza.Splash.ButtonBar.Fullscreen" parent="">
        <item name="android:background">@color/black_overlay</item>
        <item name="android:buttonBarStyle">?android:attr/buttonBarStyle</item>
    </style>


</resources>